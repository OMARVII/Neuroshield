{
  "manifest_version": 3,
  "name": "NeuroShield",
  "version": "1.1.0",
  "description": "Real-time photosensitivity protection. Detects and hides flashing and strobing videos, canvases and animations as you browse.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/settings.js",
        "src/content/detector.js",
        "src/content/sampler.js",
        "src/content/overlay.js",
        "src/content/guards.js",
        "src/content/content.js"
      ],
      "css": ["src/content/content.css"],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "NeuroShield",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-hide-page": {
      "suggested_key": { "default": "Alt+Shift+H" },
      "description": "Hide or show everything on the current page"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}

{
  "name": "neuroshield",
  "version": "1.1.0",
  "description": "Real-time photosensitivity protection for the web",
  "private": true,
  "author": "Omar Khaled",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate": "npm run lint && npm run test:unit && node scripts/build.js --check",
    "build": "node scripts/build.js",
    "icons": "node scripts/render-icons.js",
    "media": "scripts/make-media.sh",
    "screenshots": "node scripts/screenshots.js",
    "bench": "node scripts/bench.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OMARVII/Neuroshield"
  },
  "bugs": {
    "url": "https://github.com/OMARVII/Neuroshield/issues"
  },
  "homepage": "https://github.com/OMARVII/Neuroshield#readme",
  "keywords": [
    "chrome-extension",
    "accessibility",
    "epilepsy",
    "photosensitivity",
    "wcag",
    "flash-detection",
    "migraine",
    "visual-snow",
    "seizure",
    "chrome-extension-mv3"
  ]
}
